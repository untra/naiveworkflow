{
  "name": "naiveworkflow-monorepo",
  "version": "0.0.3",
  "private": true,
  "description": "Visualize Claude workflow scripts as diagramed directed graphs.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter playground dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ci": "pnpm biome ci . && pnpm -r build && pnpm typecheck && pnpm test && pnpm test:browser && pnpm audit",
    "test:browser": "playwright test",
    "audit": "pnpm audit --audit-level low"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.12",
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.11.0",
    "ajv": "^8.17.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
